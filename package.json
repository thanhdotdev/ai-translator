{
  "name": "ai-vietnamese-translator-extension",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "release:package": "npm run build && python3 scripts/package_release.py"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@radix-ui/themes": "^3.3.0",
    "@types/chrome": "^0.0.287",
    "@vitejs/plugin-react": "^4.3.4",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
